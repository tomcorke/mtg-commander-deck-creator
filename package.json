{
  "name": "mtg-commander-deck-creator",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:record": "vite --mode record",
    "dev:replay": "vite --mode replay",
    "check:dev-replay": "node --experimental-strip-types scripts/check-dev-replay.ts",
    "build": "tsc -b && pnpm build:card-index && vite build",
    "build:card-index": "node --experimental-strip-types scripts/build-card-index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"*.{json,md,ts}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"*.{json,md,ts}\" \"docs/**/*.md\"",
    "lint": "pnpm format:check && oxlint && eslint src scripts --max-warnings=0",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test",
    "check:planned-fetches:browser": "node --experimental-strip-types scripts/check-planned-fetches-browser.ts",
    "test:browser:a2-a9": "node --experimental-strip-types scripts/check-a2-a9-browser.ts",
    "test:browser:a14": "node --experimental-strip-types scripts/check-a14-browser.ts",
    "test:browser:b12": "node --experimental-strip-types scripts/check-b12-browser.ts",
    "check:batch-busy:browser": "node --experimental-strip-types scripts/check-batch-busy-browser.ts",
    "check:batch-rollover:browser": "node --experimental-strip-types scripts/check-batch-rollover-browser.ts",
    "check:card-reveal:browser": "node --experimental-strip-types scripts/check-card-reveal-browser.ts",
    "check:card-search:browser": "node --experimental-strip-types scripts/check-card-search-browser.ts",
    "check:b11:browser": "node --experimental-strip-types scripts/check-b11-browser.ts",
    "audit:recommendations": "node --experimental-strip-types scripts/recommendation-audit.ts",
    "check:a15:browser": "node --experimental-strip-types scripts/a15-functional-browser.ts",
    "typecheck": "tsc -b --noEmit",
    "check:b18:browser": "node --experimental-strip-types scripts/check-b18-browser.ts",
    "check:b10:browser": "node --experimental-strip-types scripts/check-b10-browser.ts",
    "check:contrast:browser": "node --experimental-strip-types scripts/check-contrast-browser.ts",
    "check:random-commander:browser": "node --experimental-strip-types scripts/check-random-commander-browser.ts",
    "check:primer:browser": "node --experimental-strip-types scripts/check-primer-browser.ts",
    "check:broader-commanders:browser": "node --experimental-strip-types scripts/check-broader-commanders-browser.ts",
    "check:partner-pairs:browser": "node --experimental-strip-types scripts/check-partner-pairs-browser.ts",
    "check:colour-identity-mode:browser": "node --experimental-strip-types scripts/check-colour-identity-mode-browser.ts",
    "check:popularity-deck-count:browser": "node --experimental-strip-types scripts/check-popularity-deck-count-browser.ts",
    "check:card-references:browser": "node --experimental-strip-types scripts/check-card-references-browser.ts",
    "check:local-card-index:browser": "node --experimental-strip-types scripts/check-local-card-index-browser.ts",
    "evaluate:local-retrieval": "node --experimental-strip-types scripts/evaluate-local-retrieval.ts",
    "measure:local-card-index": "node --experimental-strip-types scripts/measure-local-card-index.ts",
    "check:owned-cards:browser": "node --experimental-strip-types scripts/check-owned-cards-browser.ts",
    "check:land-fill-budget:browser": "node --experimental-strip-types scripts/check-land-fill-budget-browser.ts",
    "check:deck-board-layout:browser": "node --experimental-strip-types scripts/check-deck-board-layout-browser.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-joyride": "3.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
